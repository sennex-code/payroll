# Email (Gmail Nodemailer)
EMAIL_USER=
EMAIL_PASS=

# S3 / Cloudflare R2 Object Storage
S3_BUCKET_NAME=payroll
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
