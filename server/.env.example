# Server
BACKEND_PORT=8000

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=wahpayroll

# JWT Authentication (REQUIRED - app will not start without these)
JWT_SECRET=
